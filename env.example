# Copy to .env before running docker compose.
# The site is created on first start; changing SITE_NAME later needs a fresh volume.

# Site hostname and first-run Administrator password.
SITE_NAME=books.localhost
ADMIN_PASSWORD=admin

# Host port for the web UI.
BOOKS_PORT=8000

# Mailpit, the local mail catcher used for outgoing email.
# SMTP is exposed so other tools can send to it; the UI lists captured mail.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Sender for outgoing email. Use a valid address: Frappe rejects addresses
# without a domain, such as books@localhost.
MAIL_FROM=books@example.com
MAIL_SENDER_NAME=Frappe Books

# Named volume that keeps the SQLite database, site config and uploaded files.
BOOKS_DATA_VOLUME=frappe-books-sites

# Frappe branch cloned when building the image.
FRAPPE_BRANCH=develop
